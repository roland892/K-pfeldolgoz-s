import os
import math
import tkinter as tk
from tkinter import filedialog, messagebox
from typing import List, Tuple, Optional, Dict

import cv2
import numpy as np
from PIL import Image, ImageTk


CoinDetection = Dict[str, object]


class ForintCoinRecognizer:
    def __init__(self) -> None:
        self.coin_values = [5, 10, 20, 50, 100, 200]

    @staticmethod
    def _resize_for_display(image: np.ndarray, max_w: int = 900, max_h: int = 650) -> np.ndarray:
        h, w = image.shape[:2]
        scale = min(max_w / w, max_h / h, 1.0)
        new_w, new_h = int(w * scale), int(h * scale)
        return cv2.resize(image, (new_w, new_h), interpolation=cv2.INTER_AREA)

    @staticmethod
    def _mean_hsv_in_circle(hsv: np.ndarray, center: Tuple[int, int], radius: int) -> Tuple[float, float, float]:
        mask = np.zeros(hsv.shape[:2], dtype=np.uint8)
        cv2.circle(mask, center, max(5, int(radius * 0.6)), 255, -1)
        mean_h, mean_s, mean_v, _ = cv2.mean(hsv, mask=mask)
        return float(mean_h), float(mean_s), float(mean_v)

    @staticmethod
    def _ring_hsv(hsv: np.ndarray, center: Tuple[int, int], radius: int) -> Tuple[Tuple[float, float, float], Tuple[float, float, float]]:
        mask_inner = np.zeros(hsv.shape[:2], dtype=np.uint8)
        mask_outer = np.zeros(hsv.shape[:2], dtype=np.uint8)

        inner_r = max(4, int(radius * 0.35))
        outer_r1 = max(inner_r + 2, int(radius * 0.55))
        outer_r2 = max(outer_r1 + 2, int(radius * 0.82))

        cv2.circle(mask_inner, center, inner_r, 255, -1)
        cv2.circle(mask_outer, center, outer_r2, 255, -1)
        cv2.circle(mask_outer, center, outer_r1, 0, -1)

        inner = cv2.mean(hsv, mask=mask_inner)[:3]
        outer = cv2.mean(hsv, mask=mask_outer)[:3]
        return (float(inner[0]), float(inner[1]), float(inner[2])), (float(outer[0]), float(outer[1]), float(outer[2]))

    def classify_coin(
        self,
        mean_hsv: Tuple[float, float, float],
        inner_hsv: Tuple[float, float, float],
        outer_hsv: Tuple[float, float, float],
        radius: int
    ) -> int:
        ih, isat, iv = inner_hsv
        oh, osat, ov = outer_hsv
        h, s, v = mean_hsv

        sat_diff = isat - osat

        # --- 1. BIMETÁL (100, 200) ---
        if sat_diff > 10 and 12 <= ih <= 40:
            return 100
        if sat_diff < -10 and 12 <= oh <= 40:
            return 200

        # --- 2. SZÍN ---
        is_gold = (s > 35 and 10 <= h <= 45)

        # --- ARANY (5 Ft és 20 Ft) ---
        if 0 <= h <= 90 and s >= 50:
            # 1. Létrehozzuk az s_val-t egész számként
            s_val = int(s)

            # 2. A lemért, konkrét értékeid alapján azonosítjuk az érméket
            if s_val == 77 or s_val == 78:
                return 20
            elif s_val == 79 or s_val == 75:
                return 5
            else:
                # Biztonsági tartalék
                return 5

        # --- EZÜST ---
        if v < 150:
            return 10

        # 50 Ft: világosabb ezüst
        return 50

    def detect_coins(self, image_bgr: np.ndarray) -> Tuple[np.ndarray, List[CoinDetection], int]:
        original = image_bgr.copy()
        display = self._resize_for_display(original)
        gray = cv2.cvtColor(display, cv2.COLOR_BGR2GRAY)
        
        gray = cv2.GaussianBlur(gray, (15, 15), 0)

        circles = cv2.HoughCircles(
            gray,
            cv2.HOUGH_GRADIENT,
            dp=1.2,
            minDist=100,      
            param1=50,
            param2=35,        
            minRadius=40,     
            maxRadius=500,    
        )

        detections: List[CoinDetection] = []
        annotated = display.copy()

        if circles is None:
            return annotated, detections, 0

        circles = np.round(circles[0, :]).astype(int)

        # --- NORMALIZÁLÁS ---
        max_r = max(c[2] for c in circles)

        normalized_circles = []
        for x, y, r in circles:
            norm_r = int((r / max_r) * 200)
            normalized_circles.append((x, y, r, norm_r))

        h_img, w_img = display.shape[:2]
        center_x, center_y = w_img // 2, h_img // 2

        # A kép közepéhez legközelebb eső kört keressük
        sorted_circles = sorted(normalized_circles, key=lambda c: math.hypot(c[0] - center_x, c[1] - center_y))
        
        best_circle = sorted_circles[0]
        filtered_circles = [best_circle]

        hsv = cv2.cvtColor(display, cv2.COLOR_BGR2HSV)
        total_sum = 0

        for x, y, r, norm_r in filtered_circles:
            if x - r < 0 or y - r < 0 or x + r >= display.shape[1] or y + r >= display.shape[0]:
                continue

            mean_hsv = self._mean_hsv_in_circle(hsv, (x, y), r)
            inner_hsv, outer_hsv = self._ring_hsv(hsv, (x, y), r)
            
            value = self.classify_coin(mean_hsv, inner_hsv, outer_hsv, norm_r)
            total_sum += value

            s_val = int(mean_hsv[1])

            detections.append(
                {
                    "x": x,
                    "y": y,
                    "r": r,
                    "value": value,
                    "mean_hsv": mean_hsv,
                    "inner_hsv": inner_hsv,
                    "outer_hsv": outer_hsv,
                }
            )

            cv2.circle(annotated, (x, y), r, (0, 255, 0), 3)
            cv2.circle(annotated, (x, y), 2, (0, 0, 255), 3)
            
            cv2.putText(
                annotated,
                f"{value} Ft (norm_R:{norm_r}, S:{s_val})",
                (x - r, max(20, y - r - 10)),
                cv2.FONT_HERSHEY_SIMPLEX,
                0.8,
                (0, 0, 255),
                2,
                cv2.LINE_AA,
            )

        return annotated, detections, total_sum


class CoinApp:
    def __init__(self, root: tk.Tk) -> None:
        self.root = root
        self.root.title("Forint érmefelismerő")
        self.root.geometry("1100x780")
        self.root.configure(bg="#f2f2f2")

        self.recognizer = ForintCoinRecognizer()
        self.original_image_bgr: Optional[np.ndarray] = None
        self.current_preview_rgb: Optional[np.ndarray] = None
        self.detections: List[CoinDetection] = []
        self.total_sum: int = 0

        self._build_ui()

    def _build_ui(self) -> None:
        top_frame = tk.Frame(self.root, bg="#f2f2f2")
        top_frame.pack(fill="x", padx=10, pady=10)

        btn_load = tk.Button(
            top_frame,
            text="Kép betöltése",
            command=self.load_image,
            width=18,
            height=2,
            font=("Arial", 11, "bold"),
        )
        btn_load.pack(side="left", padx=5)

        btn_detect = tk.Button(
            top_frame,
            text="Felismerés és összegzés",
            command=self.detect_and_sum,
            width=22,
            height=2,
            font=("Arial", 11, "bold"),
        )
        btn_detect.pack(side="left", padx=5)

        btn_reset = tk.Button(
            top_frame,
            text="Törlés",
            command=self.reset_view,
            width=12,
            height=2,
            font=("Arial", 11, "bold"),
        )
        btn_reset.pack(side="left", padx=5)

        self.result_var = tk.StringVar(value="Végösszeg: 0 Ft")
        result_label = tk.Label(
            top_frame,
            textvariable=self.result_var,
            bg="#f2f2f2",
            fg="#0b5394",
            font=("Arial", 16, "bold"),
        )
        result_label.pack(side="right", padx=10)

        content_frame = tk.Frame(self.root, bg="#f2f2f2")
        content_frame.pack(fill="both", expand=True, padx=10, pady=(0, 10))

        self.image_label = tk.Label(
            content_frame,
            bg="white",
            relief="solid",
            bd=1,
            text="Itt jelenik meg a betöltött kép",
            font=("Arial", 12),
        )
        self.image_label.pack(side="left", fill="both", expand=True)

        right_panel = tk.Frame(content_frame, bg="#f2f2f2", width=320)
        right_panel.pack(side="right", fill="y", padx=(10, 0))
        right_panel.pack_propagate(False)

        info_title = tk.Label(
            right_panel,
            text="Talált érmék",
            bg="#f2f2f2",
            font=("Arial", 14, "bold"),
        )
        info_title.pack(anchor="w", pady=(0, 8))

        self.listbox = tk.Listbox(right_panel, font=("Consolas", 11), height=25)
        self.listbox.pack(fill="both", expand=True)

        help_text = (
            "Tippek a jobb felismeréshez:\n"
            "- egyszínű háttér\n"
            "- felülről fotózott érme\n"
            "- jó megvilágítás\n"
            "- ne lógjanak egymásra az érmék\n"
            "- a teljes érme legyen látható"
        )
        help_label = tk.Label(
            right_panel,
            text=help_text,
            justify="left",
            bg="#f2f2f2",
            fg="#444444",
            font=("Arial", 10),
        )
        help_label.pack(anchor="w", pady=10)

    def load_image(self) -> None:
        file_path = filedialog.askopenfilename(
            title="Válassz képet",
            filetypes=[
                ("Képfájlok", "*.png *.jpg *.jpeg *.bmp *.webp"),
                ("Minden fájl", "*.*"),
            ],
        )
        if not file_path:
            return

        image = cv2.imread(file_path)
        if image is None:
            messagebox.showerror("Hiba", "A kép nem tölthető be.")
            return

        self.original_image_bgr = image
        preview = self.recognizer._resize_for_display(image)
        preview_rgb = cv2.cvtColor(preview, cv2.COLOR_BGR2RGB)
        self.current_preview_rgb = preview_rgb
        self._show_image(preview_rgb)

        self.listbox.delete(0, tk.END)
        self.result_var.set("Végösszeg: 0 Ft")
        self.detections = []
        self.total_sum = 0

    def detect_and_sum(self) -> None:
        if self.original_image_bgr is None:
            messagebox.showwarning("Nincs kép", "Először tölts be egy képet.")
            return

        annotated_bgr, detections, total_sum = self.recognizer.detect_coins(self.original_image_bgr)
        annotated_rgb = cv2.cvtColor(annotated_bgr, cv2.COLOR_BGR2RGB)
        self.current_preview_rgb = annotated_rgb
        self._show_image(annotated_rgb)

        self.detections = detections
        self.total_sum = total_sum

        self.listbox.delete(0, tk.END)
        if not detections:
            self.listbox.insert(tk.END, "Nem sikerült érmét találni.")
            self.result_var.set("Végösszeg: 0 Ft")
            return

        counts: Dict[int, int] = {}
        for idx, det in enumerate(detections, start=1):
            value = int(det["value"])
            counts[value] = counts.get(value, 0) + 1
            self.listbox.insert(tk.END, f"{idx:02d}. érme -> {value} Ft")

        self.listbox.insert(tk.END, "--------------------------")
        for coin in sorted(counts):
            self.listbox.insert(tk.END, f"{coin:>3} Ft: {counts[coin]} db")

        self.result_var.set(f"Végösszeg: {total_sum} Ft")

    def reset_view(self) -> None:
        self.original_image_bgr = None
        self.current_preview_rgb = None
        self.detections = []
        self.total_sum = 0
        self.image_label.config(image="", text="Itt jelenik meg a betöltött kép")
        self.image_label.image = None
        self.listbox.delete(0, tk.END)
        self.result_var.set("Végösszeg: 0 Ft")

    def _show_image(self, image_rgb: np.ndarray) -> None:
        pil_img = Image.fromarray(image_rgb)
        tk_img = ImageTk.PhotoImage(pil_img)
        self.image_label.config(image=tk_img, text="")
        self.image_label.image = tk_img


def main() -> None:
    root = tk.Tk()
    app = CoinApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
